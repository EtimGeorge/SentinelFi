DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"
RESEND_API_KEY="your_resend_api_key"
EMAIL_FROM="onboarding@resend.dev"

# SuperAdmin Credentials (for initial setup and development)
# In production, these should be set securely via your deployment platform's environment variables.
# If these are not set in production, the seeder will throw an error.
# For development, if unset, a default email (superadmin@example.com) and password (password) will be used.
# SUPERADMIN_EMAIL="superadmin@example.com"
# SUPERADMIN_PASSWORD="superadminpassword"

# EXCHANGE_RATE_API_KEY from exchangerate-api.com
EXCHANGE_RATE_API_KEY=37f89f880cb399e4187c0450

# Email Config
EMAIL_PROVIDER=resend         # 'resend' or 'smtp'
EMAIL_PREVIEW_ONLY=true       # true (logs to console) or false (sends real mail)
EMAIL_FROM=onboarding@sentinelfi.com

# SMTP (If using Gmail/Mailtrap)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_user
SMTP_PASS=your_pass

# Payments
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here
PAYPAL_SANDBOX=true

# Ads monetization (all optional — 'test' provider + placeholders when unset)
ADS_PROVIDER=test            # 'test' | 'adsense' | 'admanager'
ADS_ENABLED=true
ADSENSE_CLIENT_ID=ca-pub-0000000000000000
ADSENSE_BANNER_SLOT=0000000000
# Rewarded-network server-side verification secret (REQUIRED in production
# with a real rewarded network; leave unset for test/display-only mode)
# ADS_SSV_SECRET=your_rewarded_network_shared_secret

# Cloudflare R2 object storage (uploads — replace with your real values)
# Create a bucket and an API token with Object Read & Write, or leave blank to
# fall back to local disk (uploads/) for local development.
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=sentinelfi-uploads
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_REGION=auto
# Optional: public URL prefix for stored uploads
# R2_PUBLIC_BASE_URL=https://uploads.yourdomain.com
