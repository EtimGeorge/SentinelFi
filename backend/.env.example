# =============================================================================
# SentinelFi — Backend (NestJS API) environment variables
# -----------------------------------------------------------------------------
# Copy to backend/.env (local) or backend/.env.local (overrides .env).
# Values below are SAFE PLACEHOLDERS — never commit real secrets.
# (R) = required, (O) = optional.
# Source of truth: backend/src/common/config/env-validation.schema.ts
# Keep this file, backend/.env.production.example, and render.yaml in sync.
# =============================================================================

# --- Core / app -------------------------------------------------------------
NODE_ENV=development
PORT=3001
# (R) PostgreSQL connection string.
# On Neon, use the DIRECT (unpooled) hostname for this long-running server.
# The "-pooler" hostname runs PgBouncer in transaction mode, which DISCARDS
# session settings (SET search_path) and breaks per-tenant schema routing.
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"
# (R) 64+ chars in production. Generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"
# (O) Back-compat alias for JWT_SECRET; prefer JWT_SECRET.
JWT_SECRET_KEY=
# (O) JWT lifetime (default 3600s).
JWT_EXPIRATION_TIME=3600s
# (R) Public frontend origin; anchors WebSocket CORS + email links.
FRONTEND_URL=http://localhost:3000
# (O) Extra comma-separated origins allowed on the notification WebSocket.
FRONTEND_ALLOWED_ORIGINS=
# (O) Force Swagger on/off; defaults on outside production.
SWAGGER_ENABLED=false
# (O) Run pending PUBLIC migrations at boot (default false; prefer a pre-deploy job).
RUN_MIGRATIONS_ON_BOOT=false

# --- Redis (cache + distributed throttling + Socket.IO adapter) --------------
# (O, recommended) Preferred single setting. Without it the throttler falls back
# to per-instance memory (limits not shared across replicas).
REDIS_URL=
# (O) Local-dev fallback when REDIS_URL is unset.
REDIS_HOST=localhost
REDIS_PORT=6379

# --- AI agent (FastAPI) ------------------------------------------------------
# (O) Defaults to http://localhost:8000 — set the real URL in any deploy.
AI_AGENT_URL=http://localhost:8000

# --- PDF render worker (optional; standalone Chromium) ----------------------
# (O) When PDF_WORKER_URL is set, PDFs render in the worker instead of in-process.
PDF_WORKER_URL=
# (O) Shared bearer token; must match the worker's PDF_WORKER_TOKEN.
PDF_WORKER_TOKEN=
# (O) Request + navigation timeouts (ms).
PDF_WORKER_TIMEOUT_MS=120000
PDF_NAV_TIMEOUT_MS=60000

# --- Email -------------------------------------------------------------------
# (O) 'resend' (default) or 'smtp'.
EMAIL_PROVIDER=resend
# (O) Verified sender; the provider rejects every send if unverified.
EMAIL_FROM=onboarding@resend.dev
# (O) true = log instead of send. Defaults on outside production.
EMAIL_PREVIEW_ONLY=true
# (O) SMTP fallback (used when EMAIL_PROVIDER=smtp).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# (O) Required when EMAIL_PROVIDER=resend.
RESEND_API_KEY=

# --- Payments ----------------------------------------------------------------
# (O) Paystack (billing + webhooks).
PAYSTACK_SECRET_KEY=
# (O) PayPal (billing + webhooks).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# (O) true = sandbox (default true).
PAYPAL_SANDBOX=true
# (O) 'sandbox' | 'live' (webhook signature verification).
PAYPAL_ENV=sandbox

# --- Currency ----------------------------------------------------------------
# (O) exchangerate-api.com key; defaults to the free 'demo' key when unset.
EXCHANGE_RATE_API_KEY=

# --- Cloudflare R2 object storage (uploads) ---------------------------------
# (O) Without these, uploads use local disk and do not survive deploys.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sentinelfi-uploads
R2_ENDPOINT=
R2_REGION=auto
R2_PUBLIC_BASE_URL=

# --- Ads (monetization; all optional) ---------------------------------------
ADS_PROVIDER=test
ADS_ENABLED=true
ADSENSE_CLIENT_ID=
ADSENSE_BANNER_SLOT=
# (O) Rewarded-network server-side verification secret (required in prod with a real network).
ADS_SSV_SECRET=

# --- Rate limiting (distributed, shared via Redis) ---------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=10

# --- Initial superadmin seed (production) -----------------------------------
# Required when seeding in non-dev environments.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# =============================================================================
# PDF WORKER SERVICE ONLY (backend/Dockerfile.worker → backend/src/worker.ts)
# These are NOT read by the API. Set them on the separate worker service.
# =============================================================================
# (O) Worker listen port (default 3002).
# WORKER_PORT=3002
# (O) System Chromium path (set in the worker image).
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# (O) Max simultaneous renders (default 1).
# PDF_WORKER_CONCURRENCY=1
# (O) Whole-render timeout (default 120000).
# PDF_RENDER_TIMEOUT_MS=120000
# (O) Request body cap in bytes (default 5MB).
# PDF_MAX_HTML_BYTES=5242880
