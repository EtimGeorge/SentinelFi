<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Invoice - {{ invoiceNumber }}</title>
    <style>
        body {
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            color: #333;
            margin: 0;
            padding: 0;
            font-size: 14px;
        }
        .container {
            width: 100%;
            max-width: 800px;
            margin: 0 auto;
        }
        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            padding-bottom: 20px;
            border-bottom: 3px solid {{ brandPrimaryColorHex }};
            margin-bottom: 30px;
        }
        .company-info {
            width: 50%;
        }
        .company-logo {
            max-height: 80px;
            max-width: 250px;
            margin-bottom: 15px;
        }
        .doc-title {
            text-align: right;
            width: 50%;
        }
        .doc-title h1 {
            color: {{ brandPrimaryColorHex }};
            margin: 0 0 10px 0;
            font-size: 32px;
            text-transform: uppercase;
        }
        .meta-table {
            width: 100%;
            margin-bottom: 30px;
            border-collapse: collapse;
        }
        .meta-table td {
            padding: 5px;
            vertical-align: top;
        }
        .meta-table .label {
            font-weight: bold;
            color: #555;
            width: 120px;
        }
        .flex-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 30px;
        }
        .address-box {
            width: 48%;
            background-color: #f9f9f9;
            padding: 15px;
            border-radius: 4px;
        }
        .address-box h3 {
            margin-top: 0;
            color: {{ brandPrimaryColorHex }};
            border-bottom: 1px solid #ddd;
            padding-bottom: 5px;
            margin-bottom: 10px;
            font-size: 16px;
        }
        .items-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 30px;
        }
        .items-table th {
            background-color: {{ brandPrimaryColorHex }};
            color: white;
            padding: 10px;
            text-align: left;
            font-size: 13px;
        }
        .items-table td {
            padding: 10px;
            border-bottom: 1px solid #ddd;
        }
        .items-table .text-right {
            text-align: right;
        }
        .totals-section {
            width: 100%;
            display: flex;
            justify-content: flex-end;
        }
        .totals-table {
            width: 350px;
            border-collapse: collapse;
        }
        .totals-table td {
            padding: 8px 10px;
            text-align: right;
        }
        .totals-table .label {
            font-weight: bold;
            color: #555;
            text-align: left;
        }
        .totals-table .grand-total {
            font-size: 18px;
            font-weight: bold;
            color: {{ brandPrimaryColorHex }};
            border-top: 2px solid {{ brandPrimaryColorHex }};
            border-bottom: 2px solid {{ brandPrimaryColorHex }};
        }
        .totals-table .amount-due {
            font-size: 16px;
            font-weight: bold;
            color: #d32f2f;
        }
        .footer {
            margin-top: 50px;
            padding-top: 20px;
            border-top: 1px solid #ddd;
            font-size: 11px;
            color: #777;
            text-align: center;
        }
        .status-stamp {
            position: absolute;
            top: 250px;
            right: 50px;
            font-size: 40px;
            font-weight: bold;
            color: {{#if statusColor}}{{statusColor}}{{else}}#ddd{{/if}};
            opacity: 0.3;
            transform: rotate(-15deg);
            border: 5px solid {{#if statusColor}}{{statusColor}}{{else}}#ddd{{/if}};
            padding: 10px 20px;
            border-radius: 10px;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Status Stamp (Draft, Sent, Paid, Overdue) -->
        <div class="status-stamp">{{ invoiceStatus }}</div>

        <div class="header">
            <div class="company-info">
                {{#if brandLogoBase64}}
                    <img src="{{ brandLogoBase64 }}" alt="Company Logo" class="company-logo" />
                {{else}}
                    <h2 style="color: {{ brandPrimaryColorHex }}; margin: 0 0 10px 0;">{{ tenantName }}</h2>
                {{/if}}
                <div style="color: #666; line-height: 1.5;">
                    {{#if companyAddress}}
                        {{ companyAddress }}
                    {{else}}
                        SentinelFi Platform
                    {{/if}}
                </div>
            </div>
            <div class="doc-title">
                <h1>INVOICE</h1>
                <table class="meta-table" style="text-align: right; width: 100%;">
                    <tr><td class="label">Invoice Number:</td><td>{{ invoiceNumber }}</td></tr>
                    <tr><td class="label">Date Issued:</td><td>{{ issueDate }}</td></tr>
                    <tr><td class="label">Due Date:</td><td><strong>{{ dueDate }}</strong></td></tr>
                    {{#if poNumber}}
                    <tr><td class="label">PO Number:</td><td>{{ poNumber }}</td></tr>
                    {{/if}}
                </table>
            </div>
        </div>

        <div class="flex-row">
            <div class="address-box">
                <h3>BILL TO</h3>
                <strong>{{ clientName }}</strong><br>
                {{#if clientAddress}}
                    {{ clientAddress }}<br>
                {{/if}}
                {{#if clientContact}}
                    Attn: {{ clientContact }}<br>
                {{/if}}
                {{#if clientEmail}}
                    {{ clientEmail }}
                {{/if}}
            </div>
        </div>

        <table class="items-table">
            <thead>
                <tr>
                    <th>Description</th>
                    <th class="text-right" style="width: 80px;">Qty/Hrs</th>
                    <th class="text-right" style="width: 120px;">Rate</th>
                    <th class="text-right" style="width: 120px;">Amount</th>
                </tr>
            </thead>
            <tbody>
                {{#each lineItems}}
                <tr>
                    <td>{{ this.description }}</td>
                    <td class="text-right">{{ this.quantity }}</td>
                    <td class="text-right">{{ this.formattedRate }}</td>
                    <td class="text-right">{{ this.formattedAmount }}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>

        <div class="totals-section">
            <table class="totals-table">
                <tr>
                    <td class="label">Subtotal:</td>
                    <td>{{ formattedSubtotal }}</td>
                </tr>
                <tr>
                    <td class="label">Tax ({{ taxPercent }}%):</td>
                    <td>{{ formattedTax }}</td>
                </tr>
                <tr>
                    <td class="label">Discount:</td>
                    <td>- {{ formattedDiscount }}</td>
                </tr>
                <tr class="grand-total">
                    <td class="label" style="color: {{ brandPrimaryColorHex }};">TOTAL:</td>
                    <td>{{ formattedGrandTotal }} {{ currencyCode }}</td>
                </tr>
                <tr>
                    <td class="label">Amount Paid:</td>
                    <td>{{ formattedAmountPaid }}</td>
                </tr>
                <tr class="amount-due">
                    <td class="label" style="color: #d32f2f;">AMOUNT DUE:</td>
                    <td>{{ formattedAmountDue }} {{ currencyCode }}</td>
                </tr>
            </table>
        </div>

        <div style="margin-top: 40px;">
            <h4 style="color: {{ brandPrimaryColorHex }}; margin-bottom: 5px;">Payment Instructions</h4>
            <p style="font-size: 13px; color: #444; white-space: pre-line; background-color: #f9f9f9; padding: 15px; border-left: 4px solid {{ brandPrimaryColorHex }};">
                {{ paymentInstructions }}
            </p>
        </div>

        <div class="footer">
            Generated securely via SentinelFi Document Control System &bull; {{ generationDate }}
        </div>
    </div>
</body>
</html>
