<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{subject}}</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap');
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: #0d1117;
            margin: 0;
            padding: 20px 0 40px;
            color: #1a202c;
        }
        .wrapper {
            max-width: 620px;
            margin: 0 auto;
        }
        .container {
            max-width: 620px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
        }
        .header {
            background: linear-gradient(135deg, #000d16 0%, #001f2e 50%, #00303d 100%);
            color: #ffffff;
            padding: 32px 40px;
            border-bottom: 2px solid #00A3B5;
        }
        .header-logo {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .header-icon {
            width: 40px;
            height: 40px;
            background: rgba(0,163,181,0.15);
            border: 1px solid rgba(0,163,181,0.4);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }
        .header-brand {
            font-size: 22px;
            font-weight: 900;
            letter-spacing: -1px;
            color: #ffffff;
        }
        .header-brand span {
            color: #00A3B5;
        }
        .header-tagline {
            font-size: 11px;
            color: rgba(255,255,255,0.5);
            margin-top: 4px;
            letter-spacing: 1px;
            text-transform: uppercase;
        }
        .content {
            padding: 40px;
            line-height: 1.7;
            color: #1a202c;
        }
        .divider {
            height: 1px;
            background: #edf2f7;
            margin: 32px 0;
        }
        .footer {
            background: #f8fafc;
            padding: 28px 40px;
            border-top: 1px solid #e2e8f0;
        }
        .footer-brand-section {
            text-align: center;
            margin-bottom: 20px;
            padding-bottom: 20px;
            border-bottom: 1px solid #e2e8f0;
        }
        .footer-brand-name {
            font-size: 14px;
            font-weight: 700;
            color: #2d3748;
            letter-spacing: -0.3px;
        }
        .footer-owner {
            font-size: 11px;
            color: #4a5568;
            margin-top: 6px;
            line-height: 1.5;
        }
        .footer-funder {
            font-size: 11px;
            color: #718096;
            margin-top: 4px;
            line-height: 1.5;
        }
        .footer-legal {
            text-align: center;
            font-size: 11px;
            color: #a0aec0;
            line-height: 1.6;
        }
        .footer-links {
            text-align: center;
            margin-top: 12px;
        }
        .footer-links a {
            font-size: 11px;
            color: #00A3B5;
            text-decoration: none;
            margin: 0 8px;
        }
        .button {
            display: inline-block;
            padding: 14px 28px;
            background: linear-gradient(135deg, #00A3B5, #007a87);
            color: #ffffff !important;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 700;
            font-size: 15px;
            margin-top: 20px;
            letter-spacing: 0.3px;
        }
        .alert-success { color: #22543d; background: #f0fff4; border: 1px solid #68d391; border-radius: 8px; padding: 12px 16px; margin: 16px 0; }
        .alert-warning { color: #744210; background: #fffbeb; border: 1px solid #f6c90e; border-radius: 8px; padding: 12px 16px; margin: 16px 0; }
        .alert-danger  { color: #742a2a; background: #fff5f5; border: 1px solid #fc8181; border-radius: 8px; padding: 12px 16px; margin: 16px 0; }
        .info-table { width: 100%; border-collapse: collapse; margin: 24px 0; }
        .info-table td { padding: 10px 0; border-bottom: 1px solid #edf2f7; font-size: 14px; }
        .info-table td:first-child { color: #718096; font-weight: 500; width: 45%; }
        .info-table td:last-child { color: #1a202c; font-weight: 600; text-align: right; }
        .amount-highlight { font-size: 28px; font-weight: 900; color: #00A3B5; }
    </style>
</head>
<body>
    <div class="wrapper">
        <div class="container">
            <div class="header">
                <div class="header-logo">
                    <div class="header-icon">🛡️</div>
                    <div>
                        <div class="header-brand">SENTINEL<span>FI</span><sup style="font-size:10px;">®</sup></div>
                        <div class="header-tagline">Financial Intelligence Platform</div>
                    </div>
                </div>
            </div>

            <div class="content">
                {{{body}}}
            </div>

            <div class="footer">
                <div class="footer-brand-section">
                    <div class="footer-brand-name">SentinelFi® Financial Intelligence Platform</div>
                    <div class="footer-owner">
                        Built &amp; Owned by <strong>Seancrystal Global Services Limited</strong><br>
                        RC Number: [RC-XXXXXXXX] &bull; Nigeria
                    </div>
                    <div class="footer-funder">
                        Funded by <strong>Solution Energy and Engineering Services Limited</strong>
                    </div>
                </div>
                <div class="footer-legal">
                    &copy; {{year}} Seancrystal Global Services Limited. All rights reserved.<br>
                    SentinelFi® is a registered trademark of Seancrystal Global Services Limited.<br>
                    Automated WBS Governance &bull; AI Financial Intelligence &bull; Multi-Tenant Sovereignty
                </div>
                <div class="footer-links">
                    <a href="{{appUrl}}/legal/privacy">Privacy Policy</a>
                    <a href="{{appUrl}}/legal/terms">Terms of Service</a>
                    <a href="mailto:support@sentinelfi.com">Support</a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
