<div style="margin-bottom: 8px;">
  <span style="display:inline-block;padding:4px 12px;background:#f0fff4;border:1px solid #68d391;border-radius:20px;color:#22543d;font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;">✅ Payment Confirmed</span>
</div>

<h1 style="font-size:26px;font-weight:900;color:#1a202c;margin:16px 0 4px;letter-spacing:-0.5px;">Your Receipt is Ready</h1>
<p style="color:#718096;font-size:15px;margin:0 0 28px;">Here's a summary of your payment for <strong>{{companyName}}</strong>.</p>

<div class="alert-success">
  <strong>✅ Payment Successful</strong> — Your SentinelFi® workspace has been provisioned and is ready to use.
</div>

<div style="text-align:center;margin:28px 0;">
  <div class="amount-highlight">${{amountFormatted}}</div>
  <div style="color:#718096;font-size:13px;margin-top:6px;">{{plan}} Plan · {{billingCycle}}</div>
</div>

<table class="info-table">
  <tr><td>Receipt Number</td><td>{{invoiceNumber}}</td></tr>
  <tr><td>Company</td><td>{{companyName}}</td></tr>
  <tr><td>Billed To</td><td>{{adminEmail}}</td></tr>
  <tr><td>Plan</td><td>{{plan}}</td></tr>
  <tr><td>Billing Cycle</td><td>{{billingCycle}}</td></tr>
  <tr><td>Payment Gateway</td><td>{{gateway}}</td></tr>
  <tr><td>Reference</td><td style="font-family:monospace;font-size:12px;">{{gatewayReference}}</td></tr>
  <tr><td>Subscription Period</td><td>{{periodStart}} → {{periodEnd}}</td></tr>
  <tr><td>Amount Paid</td><td><strong>${{amountFormatted}} USD</strong></td></tr>
  <tr><td>Status</td><td><span style="color:#22543d;font-weight:700;">PAID</span></td></tr>
</table>

{{#if hasAttachment}}
<div style="background:#f7f9fc;border:1px solid #e2e8f0;border-radius:8px;padding:16px;margin:20px 0;display:flex;align-items:center;gap:12px;">
  <span style="font-size:22px;">📎</span>
  <div>
    <div style="font-weight:700;color:#2d3748;font-size:14px;">Tax Invoice Attached</div>
    <div style="color:#718096;font-size:12px;">Your official PDF invoice is attached to this email for your records.</div>
  </div>
</div>
{{/if}}

<p style="color:#4a5568;font-size:14px;margin-top:24px;">
  Your workspace magic-link has been dispatched separately. Check your inbox (and spam folder) for an email with your access link.
</p>

<div style="text-align:center;margin:28px 0;">
  <a href="{{dashboardUrl}}" class="button">Access Your Dashboard →</a>
</div>

<p style="color:#a0aec0;font-size:12px;text-align:center;margin-top:24px;">
  Need help? Contact us at <a href="mailto:support@sentinelfi.com" style="color:#00A3B5;">support@sentinelfi.com</a>
</p>
