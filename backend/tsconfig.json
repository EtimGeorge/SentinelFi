{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./src",

    "typeRoots": [
      "./node_modules/@types",
      "../node_modules/@types"
    ],
    "paths": {
      "@shared/*": ["../../shared/*"],
      "@src/*": ["./*"],
      "@app/*": ["./app/*"],
      "@auth/*": ["./auth/*"],
      "@common/*": ["./common/*"],
      "@audit/*": ["./audit/*"],
      "@tenants/*": ["./tenants/*"],
      "@wbs/*": ["./wbs/*"],
      "@projects/*": ["./projects/*"],
      "@operational-budgets/*": ["./operational-budgets/*"],
      "@superadmin/*": ["./superadmin/*"],
      "@database/*": ["./database/*"]
    },
    "incremental": true,
    "skipLibCheck": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "strict": true,
    "lib": ["es2020"]
  },
  "include": ["src/**/*", "../shared/types/**/*"],
  "references": [{ "path": "../shared" }]
}