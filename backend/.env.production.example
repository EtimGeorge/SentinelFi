# =============================================================================
# SentinelFi — Backend (NestJS API) PRODUCTION environment variables
# -----------------------------------------------------------------------------
# Set these in your host (Render Blueprint / dashboard). DO NOT commit values.
# Same key set as backend/.env.example — keep the two in sync.
# (R) = required, (O) = optional.
# =============================================================================

# --- Core / app -------------------------------------------------------------
NODE_ENV=production
PORT=3001
# (R) Neon DIRECT (unpooled) hostname — do NOT use the "-pooler" host: it runs
# PgBouncer in transaction mode, which discards session settings (SET
# search_path) and breaks per-tenant schema routing. Include ?sslmode=require.
DATABASE_URL=postgresql://<user>:<password>@<direct-host>/<database>?sslmode=require
# (R) 64+ chars. Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING
JWT_SECRET_KEY=
JWT_EXPIRATION_TIME=3600s
# (R) Public frontend origin (also anchors WebSocket CORS + email links).
FRONTEND_URL=https://app.sentinelfi.com
FRONTEND_ALLOWED_ORIGINS=
SWAGGER_ENABLED=false
RUN_MIGRATIONS_ON_BOOT=false

# --- Redis -------------------------------------------------------------------
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379

# --- AI agent ----------------------------------------------------------------
AI_AGENT_URL=https://sentinelfi-ai-agent.onrender.com

# --- PDF render worker -------------------------------------------------------
PDF_WORKER_URL=
PDF_WORKER_TOKEN=
PDF_WORKER_TIMEOUT_MS=120000
PDF_NAV_TIMEOUT_MS=60000

# --- Email -------------------------------------------------------------------
EMAIL_PROVIDER=resend
EMAIL_FROM=notifications@yourdomain.com
EMAIL_PREVIEW_ONLY=false
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# --- Payments ----------------------------------------------------------------
PAYSTACK_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_SANDBOX=false
PAYPAL_ENV=live

# --- Currency ----------------------------------------------------------------
EXCHANGE_RATE_API_KEY=

# --- Cloudflare R2 object storage -------------------------------------------
# Required in production so uploads survive deploys.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sentinelfi-uploads
R2_ENDPOINT=
R2_REGION=auto
R2_PUBLIC_BASE_URL=

# --- Ads ---------------------------------------------------------------------
ADS_PROVIDER=test
ADS_ENABLED=true
ADSENSE_CLIENT_ID=
ADSENSE_BANNER_SLOT=
ADS_SSV_SECRET=

# --- Initial superadmin seed -------------------------------------------------
# (R in production if seeding) The seeder fails fast if these are unset in prod.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
