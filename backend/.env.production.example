# --- PRODUCTION BACKEND ENVIRONMENT VARIABLES ---
# Set these in your hosting provider (Render, Railway, etc.)
# DO NOT COMMIT THE ACTUAL VALUES TO GIT

# Connection to your Production Neon Database
# Ensure it includes ?sslmode=require
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require

# Security: Generated a long random string for production
# You can use: openssl rand -base64 32
JWT_SECRET_KEY=REPLACE_WITH_A_REAL_SECURE_RANDOM_STRING
JWT_EXPIRATION_TIME=3600s

# App Config
NODE_ENV=production
FRONTEND_URL=https://app.sentinelfi.com
PORT=3001

# Database Seeding (Keep false for production)
SEED_SUPERADMIN=false
# SUPERADMIN_PASSWORD is only used if SEED_SUPERADMIN is true
# SuperAdmin Credentials (for initial setup and development)
# In production, these should be set securely via your deployment platform's environment variables.
# If these are not set in production, the seeder will throw an error.
# For development, if unset, a default email (superadmin@example.com) and password (password) will be used.
SUPERADMIN_EMAIL=superadmin@setinelfi.com
SUPERADMIN_PASSWORD=password

# Email Service (Resend)
RESEND_API_KEY=re_your_production_api_key
EMAIL_FROM=notifications@yourdomain.com

# Throttler Configuration
THROTTLE_TTL=60
THROTTLE_LIMIT=20

# EXCHANGE_RATE_API_KEY from exchangerate-api.com
EXCHANGE_RATE_API_KEY=37f89f880cb399e4187c0450

# Cloudflare R2 object storage (uploads — required in production so files survive deploys)
# Create a bucket and an API token with Object Read & Write; replace the placeholders.
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=sentinelfi-uploads
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_REGION=auto
# Optional: public URL prefix for stored uploads, e.g. https://uploads.yourdomain.com
# R2_PUBLIC_BASE_URL=https://uploads.yourdomain.com



### NOTE SECOND VIEW

What to set in Production (Vercel / Render Dashboards):
Since you shouldn't commit production secrets to Git, you will enter these same Names into the Vercel/Render settings but with the Production Values:

In Vercel Dashboard (Frontend):
Key: NEXT_PUBLIC_API_URL
Value: https://your-api-url.com/api/v1
In Render/Railway Dashboard (Backend):
Key: DATABASE_URL
Value: postgresql://prod-user:prod-pass@prod-host...
Key: FRONTEND_URL
Value: https://your-app-url.vercel.app
Key: SEED_SUPERADMIN
Value: false