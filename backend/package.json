{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start --entryFile backend/src/main",
    "start:dev": "nest start --watch --entryFile backend/src/main --exec \"node --require ts-node/register --require tsconfig-paths/register\"",
    "start:local": "nest start --debug --watch",
    "lint": "set NODE_OPTIONS=--max-old-space-size=4096 && eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "postbuild": "powershell -Command \"mkdir .\\dist\\database\\ -Force\" && copy /Y .\\src\\database\\tenant-schema.sql .\\dist\\database\\tenant-schema.sql",
    "test": "jest"
  },
  "dependencies": {
    "@nestjs/platform-socket.io": "^11.1.11",
    "@nestjs/platform-ws": "^11.1.11",
    "@nestjs/testing": "^11.1.11",
    "@nestjs/throttler": "^6.5.0",
    "cookie-parser": "^1.4.7",
    "docx": "^9.5.1",
    "exceljs": "^4.4.0",
    "jest": "^30.2.0",
    "pdf-lib": "^1.17.1",
    "sentinelfi-monorepo": "file:..",
    "ts-jest": "^29.4.6",
    "tsconfig-paths": "^4.2.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/exceljs": "^0.5.3",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/jest": "^30.0.0",
    "@types/stack-utils": "^2.0.3",
    "@types/ws": "^8.18.1",
    "@types/yargs": "^17.0.35",
    "ts-node": "^10.9.2",
    "tsconfig-paths-jest": "^0.0.1"
  }
}
