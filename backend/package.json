{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start --entryFile backend/src/main",
    "start:dev": "set NODE_OPTIONS=--max-old-space-size=8192 && nest start --watch --entryFile backend/src/main --exec \"node --require ts-node/register --require tsconfig-paths/register\"",
    "start:local": "nest start --debug --watch",
    "lint": "set NODE_OPTIONS=--max-old-space-size=4096 && eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "seed:superadmin": "ts-node -r tsconfig-paths/register scripts/seed-superadmin.ts",
    "db:run-tenant-migrations": "ts-node -r tsconfig-paths/register scripts/run-tenant-migrations.ts",
    "typeorm": "ts-node -r reflect-metadata -r tsconfig-paths/register ../node_modules/typeorm/cli.js -d ormconfig.ts",
    "typeorm:generate": "npm run typeorm -- migration:generate src/migrations/public/AddClientEntity",
    "typeorm:run": "npm run typeorm -- migration:run",
    "typeorm:revert": "npm run typeorm -- migration:revert"
  },
  "dependencies": {
    "@nestjs/platform-socket.io": "^11.1.12",
    "@nestjs/platform-ws": "^11.1.11",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/testing": "^11.1.11",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.12",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "docx": "^9.5.1",
    "exceljs": "^4.4.0",
    "glob": "^13.0.0",
    "handlebars": "^4.7.8",
    "jest": "^30.2.0",
    "nestjs-cls": "^6.2.0",
    "nodemailer": "^7.0.12",
    "pdf-lib": "^1.17.1",
    "resend": "^6.7.0",
    "sentinelfi-monorepo": "file:..",
    "ts-jest": "^29.4.6",
    "tsconfig-paths": "^4.2.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/exceljs": "^0.5.3",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/jest": "^30.0.0",
    "@types/stack-utils": "^2.0.3",
    "@types/ws": "^8.18.1",
    "@types/yargs": "^17.0.35",
    "ts-node": "^10.9.2",
    "tsconfig-paths-jest": "^0.0.1"
  }
}
