# ==========================================================================
# SentinelFi: Production Environment Configuration (Master Manifest)
# ==========================================================================
# This file is used by Docker Compose and the individual sub-modules.
# SECURITY: Never commit changes to this file to version control.

# --- 1. CORE SYSTEM --------------------------------------------------------
NODE_ENV=production
PORT=3000

# --- 2. DATABASE (Neon / PostgreSQL) ---------------------------------------
DATABASE_URL=postgresql://neondb_owner:npg_Zj7Im1SgebkV@ep-spring-feather-ahvamwz8-pooler.c-3.us-east-1.aws.neon.tech/neondb?sslmode=require

# --- 3. REDIS (Caching & Scalability) --------------------------------------
# In Docker, use the service name 'redis'. For local cloud, provide the host URL.
REDIS_HOST=redis
REDIS_PORT=6379

# --- 4. SECURITY (JWT & AUTH) ----------------------------------------------
# 64+ character random string for security
JWT_SECRET=79afea6641c4e0c8703314d7de68a6078c3e8630908c7e1658de5920f859b100
JWT_EXPIRATION_TIME=3600s

# --- 5. NETWORK & TOPOLOGY -------------------------------------------------
# FRONTEND_URL: The canonical URL of the client application
FRONTEND_URL=http://localhost:3001

# AI_AGENT_URL: Backend internal connection to the Python AI Agent
AI_AGENT_URL=http://ai-agent:8000

# BACKEND_INTERNAL_URL: Used by Next.js rewrites to proxy API calls
# LOCAL: http://127.0.0.1:3001 | DOCKER: http://backend:3000
BACKEND_INTERNAL_URL=http://backend:3000

# --- 6. AI AGENT (FastAPI / Gemini) ----------------------------------------
# Required for LangChain / Financial Insights
GEMINI_API_KEY=your_gemini_api_key_here
ALLOWED_ORIGINS=http://localhost:3001

# --- 7. EXTERNAL SERVICES & EMAIL -------------------------------------------
# Options: 'resend' or 'smtp'
EMAIL_PROVIDER=resend
EMAIL_FROM=SentinelFi <onboarding@resend.dev>

# Resend Configuration (Default)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=onboarding@resend.dev

# SMTP Configuration (Standard Email Servers)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Exchange Rates
EXCHANGE_RATE_API_KEY=37f89f880cb399e4187c0450

# Development Controls: Set to 'false' to send REAL emails in development
EMAIL_PREVIEW_ONLY=true

# --- 8. PAYMENT GATEWAYS (Production Credentials) ---------------------------
# Paystack (Africa)
PAYSTACK_SECRET_KEY=sk_live_xxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxx

# PayPal (Global)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_SANDBOX=true

# --- 9. AI FAILOVER (Optional OpenRouter) -----------------------------------
# To use OpenRouter as a fallback, provide these.
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# --- 9. INITIAL PROVISIONING (Seeder) --------------------------------------
# Automatically seeds logic if these are present
SUPERADMIN_EMAIL=superadmin@sentinelfi.com
SUPERADMIN_PASSWORD=password
SEED_SUPERADMIN=true

# --- 10. RATE LIMITING -----------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=10
