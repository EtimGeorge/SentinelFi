# --- PRODUCTION FRONTEND ENVIRONMENT VARIABLES ---
# Set these in your Vercel Project Dashboard
# Settings > Environment Variables

# The public URL of your live backend API
# Ensure it ends with /api/v1
NEXT_PUBLIC_API_URL=https://api.sentinelfi.com/api/v1

# --- Ads monetization (AdSense display) ---
# Publisher ID from AdSense dashboard (enables real DisplayAd units).
# Leave unset in dev — components render a labeled placeholder instead.
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-0000000000000000
# NEXT_PUBLIC_ADSENSE_BANNER_SLOT=0000000000

# Optional: If you want to use Next.js Analytics or Speed Insights
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
