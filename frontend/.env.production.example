# =============================================================================
# SentinelFi — Frontend (Next.js) PRODUCTION environment variables
# -----------------------------------------------------------------------------
# Set these in your host (Render Blueprint / Vercel dashboard).
# NEXT_PUBLIC_* are inlined at BUILD time — they must be present when the image
# is built, not just at runtime. Same key set as frontend/.env.example.
# (R) = required, (O) = optional.
# =============================================================================

# (R) Public backend API base URL (include the /api/v1 suffix).
NEXT_PUBLIC_API_URL=https://api.sentinelfi.com/api/v1
# (O) Public WebSocket URL, e.g. wss://api.sentinelfi.com. If unset, derived
# from NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_WS_URL=

# (O) AdSense — leave unset to render labeled placeholders.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_BANNER_SLOT=

# --- Build / server-only (never exposed to the browser) ---------------------
# (O) Private URL used by Next.js rewrites/proxy to reach the API.
BACKEND_INTERNAL_URL=http://sentinelfi-api:3001
# (O) Same-origin value used to build CSP / WebSocket allowlists at build time.
FRONTEND_URL=https://app.sentinelfi.com
# (O) Optional Vercel Analytics id.
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
