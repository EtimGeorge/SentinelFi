# =============================================================================
# SentinelFi — Frontend (Next.js) environment variables
# -----------------------------------------------------------------------------
# Copy to frontend/.env.local. NEXT_PUBLIC_* are inlined at BUILD time.
# (R) = required, (O) = optional.
# Keep this file and frontend/.env.production.example in sync.
# =============================================================================

# (R) Backend base URL the browser calls (include the /api/v1 suffix).
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# (O) Notification WebSocket URL. If unset, derived from NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_WS_URL=

# (O) AdSense — leave unset to render labeled placeholders.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_BANNER_SLOT=

# --- Build / server-only (never exposed to the browser) ---------------------
# (O) Private URL used by Next.js rewrites/proxy to reach the API (server side).
BACKEND_INTERNAL_URL=http://localhost:3001
# (O) Same-origin value used to build CSP / WebSocket allowlists at build time.
FRONTEND_URL=http://localhost:3000
# (O) Optional Vercel Analytics id.
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
