# ==========================================================================
# SentinelFi AI Orchestration Engine — environment variables
# ==========================================================================
# Copy this file to .env in the ai-agent/ directory and fill in your values.
# NEVER commit .env to version control. (R) = required, (O) = optional.
# The app reads these names EXACTLY — notably AI_AGENT_ALLOWED_ORIGINS
# (NOT ALLOWED_ORIGINS).
# ==========================================================================

# --- Google Gemini (primary provider) -------------------------------------
# (R unless OPENROUTER_API_KEY is set) https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# (O) Override the default model (default: gemini-1.5-flash).
GEMINI_MODEL=gemini-1.5-flash

# --- OpenRouter (fallback; tried first in the failover chain) --------------
# (O, recommended) https://openrouter.ai/keys
OPENROUTER_API_KEY=
# (O, recommended) Comma-separated fallback chain, tried in order. Free-model
# IDs churn monthly — list 2-3 from DIFFERENT providers so one outage does not
# take down AI. Verify live IDs at https://openrouter.ai/models?q=free
OPENROUTER_MODELS=
# (O) Single-model override (backward compatibility).
OPENROUTER_MODEL=

# --- Ollama (local fallback; registered LAST in the chain) ------------------
# (O) Reached only when every cloud leg fails. Free + private (never leaves host).
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Security --------------------------------------------------------------
# (O) Comma-separated CORS origins. In production this MUST be the NestJS
# backend URL ONLY (never a browser URL).
AI_AGENT_ALLOWED_ORIGINS=http://localhost:3000

# --- Server ----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
