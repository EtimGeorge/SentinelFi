# ==========================================================================
# SentinelFi AI Orchestration Engine — Environment Variables
# ==========================================================================
# Copy this file to .env in the ai-agent/ directory and fill in your values.
# NEVER commit .env to version control.

# --- Core AI Provider (Google Gemini) ----------------------------------------
# Required. Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Security ----------------------------------------------------------------
# Comma-separated list of origins allowed to call this agent.
# In production, this MUST be your NestJS backend URL ONLY (never a browser URL).
ALLOWED_ORIGINS=http://localhost:3000

# --- Server Configuration -----------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Rate Limiting (requests per window) -------------------------------------
# These are defaults — the code enforces them via slowapi.
# Adjust if your server handles higher legitimate load.
CHAT_RATE_LIMIT=30/minute
ANALYSIS_RATE_LIMIT=15/minute
FORECAST_RATE_LIMIT=20/minute
UPLOAD_RATE_LIMIT=10/minute
